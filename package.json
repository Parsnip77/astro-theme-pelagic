{
  "name": "astro-theme-pelagic",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "A typography-first multilingual Astro blog theme.",
  "license": "MIT",
  "homepage": "https://github.com/Parsnip77/astro-theme-pelagic",
  "repository": "https://github.com/Parsnip77/astro-theme-pelagic",
  "bugs": "https://github.com/Parsnip77/astro-theme-pelagic/issues",
  "keywords": [
    "astro",
    "blog",
    "theme",
    "typography",
    "multilingual"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "dev:checked": "astro check && astro dev",
    "build": "pnpm validate:content && astro check && astro build && pnpm apply-lqip && pnpm validate:build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "validate:build": "node --import tsx scripts/validate-build.ts",
    "content:manifest": "node --import tsx scripts/validate-content.ts --write-manifest",
    "test:layout": "playwright test",
    "verify": "pnpm lint && pnpm build && pnpm test:layout",
    "new-post": "node --import tsx scripts/new-post.ts",
    "apply-lqip": "node --import tsx scripts/apply-lqip.ts",
    "format-posts": "node --import tsx scripts/format-posts.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.1.5",
    "astro-compress": "^2.4.1",
    "astro-og-canvas": "^0.11.0",
    "canvaskit-wasm": "^0.41.1",
    "feed": "^5.2.0",
    "katex": "^0.16.45",
    "lite-youtube-embed": "^0.3.4",
    "markdown-it": "^14.1.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.14.0",
    "node-html-parser": "^7.1.0",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.2",
    "sharp": "^0.34.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.1.1",
    "@astrojs/check": "^0.9.8",
    "@playwright/test": "1.59.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/sanitize-html": "^2.16.1",
    "@unocss/astro": "66.6.8",
    "@unocss/eslint-plugin": "66.6.8",
    "@unocss/preset-attributify": "66.6.8",
    "@unocss/reset": "66.6.8",
    "astro-eslint-parser": "^1.4.0",
    "autocorrect-node": "^2.14.0",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^1.7.0",
    "fast-glob": "^3.3.3",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "unocss": "66.6.8",
    "unocss-preset-theme": "^0.14.1",
    "yaml": "^2.8.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": "eslint --fix"
  }
}
