---
import type { Language } from '@/i18n/config'
import LanguageSwitcherIcon from '@/assets/icons/languages.svg'
import ThemeToggleIcon from '@/assets/icons/theme-toggle.svg'
import { themeConfig } from '@/config'
import { getNextSupportedLangPath } from '@/i18n/path'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

interface Props {
  supportedLangs: Language[]
}

const { supportedLangs } = Astro.props
const { currentLang, getLocalizedPath } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

const {
  light: { background: lightMode },
  dark: { background: darkMode },
} = themeConfig.color

const navItems = [
  { href: '/', label: currentUI.posts },
  { href: '/tags/', label: currentUI.tags },
  { href: '/about/', label: currentUI.about },
]

const showLanguageSwitcher = supportedLangs.length > 1
const nextLanguagePath = showLanguageSwitcher
  ? getNextSupportedLangPath(Astro.url.pathname, supportedLangs)
  : undefined
---

<div class="post-topbar-spacer">
  <nav
    aria-label="Article navigation"
    class="post-topbar no-heti flex justify-end overflow-x-auto whitespace-nowrap text-3.4 c-secondary font-navbar scrollbar-hidden sm:text-3.6"
  >
    <div class="flex items-center gap-2.5">
    {navItems.map(item => (
      <>
        <a
          href={getLocalizedPath(item.href)}
          class="highlight-hover py-1 transition-colors after:bottom-0.38em hover:c-primary"
        >
          {item.label}
        </a>
        <span aria-hidden="true" class="c-secondary/30">/</span>
      </>
    ))}

    {showLanguageSwitcher && nextLanguagePath && (
      <>
        <a
          id="language-switcher"
          href={nextLanguagePath}
          class="aspect-square w-3.9 c-secondary transition-colors active:scale-90 hover:c-primary"
          aria-label="Switch article language"
        >
          <LanguageSwitcherIcon aria-hidden="true" class="h-full w-full" />
        </a>
        <span aria-hidden="true" class="c-secondary/30">/</span>
      </>
    )}

    <button
      id="theme-toggle-button"
      class="aspect-square w-3.8 c-secondary transition-colors active:scale-90 hover:c-primary"
      data-light-mode={lightMode}
      data-dark-mode={darkMode}
      aria-label="Switch light/dark theme"
    >
      <ThemeToggleIcon aria-hidden="true" fill="currentColor" />
    </button>
    </div>
  </nav>
</div>

<script>
function applyTheme(isDark: boolean) {
  document.documentElement.classList.toggle('dark', isDark)

  const metaThemeColor = document.head.querySelector('meta[name="theme-color"]')
  const themeButton = document.getElementById('theme-toggle-button')
  const lightMode = themeButton?.dataset.lightMode
  const darkMode = themeButton?.dataset.darkMode

  if (metaThemeColor && lightMode && darkMode) {
    metaThemeColor.setAttribute('content', isDark ? darkMode : lightMode)
  }

  localStorage.setItem('theme', isDark ? 'dark' : 'light')
  document.dispatchEvent(new Event('theme-changed'))
}

function toggleTheme() {
  applyTheme(!document.documentElement.classList.contains('dark'))
}

function handleThemeToggle(event: MouseEvent) {
  if (!(event.target instanceof Element) || !event.target.closest('#theme-toggle-button')) {
    return
  }

  if (document.documentElement.classList.contains('reduce-motion')) {
    toggleTheme()
    return
  }

  document.documentElement.style.setProperty('view-transition-name', 'theme-toggle-transition')
  document.documentElement.setAttribute('data-theme-changing', '')

  document.startViewTransition(toggleTheme).finished.then(() => {
    document.documentElement.style.removeProperty('view-transition-name')
    document.documentElement.removeAttribute('data-theme-changing')
  })
}

function handleSystemChange(event: MediaQueryListEvent) {
  applyTheme(event.matches)
}

document.addEventListener('click', handleThemeToggle)
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', handleSystemChange)
</script>
