---
import Giscus from '@/components/Comment/Giscus.astro'
import { themeConfig } from '@/config'

const { enabled: enableComment } = themeConfig.comments

const giscusRepo = themeConfig.comments.giscus?.repo ?? ''
const showGiscus = enableComment && Boolean(giscusRepo.trim())
---

{showGiscus && <Giscus />}
